# Instagram
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Optional: sessionid cookie from a currently logged-in Instagram browser session.
# When set, it is used instead of the username/password login above.
INSTAGRAM_SESSION_ID=

# X / Twitter: Cookie header exported from a logged-in x.com browser session.
# Must include auth_token and ct0. Treat it like a password; never commit it.
TWEETKIT_COOKIE=

# Collector behavior (seconds / counts)
SALES_LIST_REQUEST_INTERVAL_SECONDS=1.0
SALES_LIST_MAX_RETRIES=2
SALES_LIST_RETRY_DELAY_SECONDS=5.0
